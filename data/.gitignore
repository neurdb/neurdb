# Ignore everything under data/ (downloaded datasets, archives, exports).
*
# ...except the bookkeeping files.
!.gitignore
!README.md
# ...and keep the workload SQL/scripts tracked (but not data dumped there).
!workloads/
workloads/*
!workloads/*.sql
!workloads/*.sh
!workloads/*.md
# CSV dumps from dump_tasks.sh are scratch -- never track them.
workloads/dump/
